# Frontend Environment Variables
# 
# VITE_CODESPACE_NAME: Required for Codespaces support
# Set this to your Codespace name (e.g., my-codespace-name)
# If not set, the app will use localhost:8000 for API calls
#
# Example for Codespaces:
# VITE_CODESPACE_NAME=my-codespace-name
#
# For local development, you can either:
# 1. Leave this empty (will use http://localhost:8000/api)
# 2. Set it if testing Codespaces URLs locally

VITE_CODESPACE_NAME=
